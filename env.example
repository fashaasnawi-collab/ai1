# Gemini API key. Put the real key in Render Environment Variables,
# not in GitHub.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Change this to a Gemini model available to your API project.
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=10000
MAX_CONCURRENT_REQUESTS=1
MAX_QUEUE_SIZE=20
MAX_IMAGE_MB=10

# CORS:
# For testing, "*" is convenient. For production, replace it with your
# actual app/web origin(s).
CORS_ORIGIN=*
